<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<!--
  testng.xml
  ============
  Main TestNG suite for the TaskFlow Pro automation POC.
  Groups tests into logical sections matching the application features.

  To run locally:
    mvn test -Dapp.url=http://localhost:8080 -Dbrowser=chrome -Dheadless=false

  To run in CI (triggered by repository_dispatch):
    Values are injected by GitHub Actions via Maven -D flags.
-->

<suite name="TaskFlow Pro – Full Regression Suite"
       verbose="1"
       thread-count="1"
       parallel="none">

  <!-- ===== Suite-level parameters (overridden by Maven -D flags) ===== -->
  <parameter name="browser"  value="chrome"/>
  <parameter name="headless" value="true"/>

  <!-- ===== Test Group: Page Structure & Stats ===== -->
  <test name="Header and Statistics Tests">
    <classes>
      <class name="com.qa.tests.TaskFlowHeaderAndStatsTest"/>
    </classes>
  </test>

  <!-- ===== Test Group: Add Task Form ===== -->
  <test name="Add Task Form Tests">
    <classes>
      <class name="com.qa.tests.TaskFlowAddTaskTest"/>
    </classes>
  </test>

  <!-- ===== Test Group: Activity Feed ===== -->
  <test name="Activity Feed Tests">
    <classes>
      <class name="com.qa.tests.TaskFlowActivityFeedTest"/>
    </classes>
  </test>

  <!--
    NOTE: To enable parallel test execution, change:
      parallel="tests"  thread-count="3"
    Each <test> block will run in its own thread.
    BaseTest uses ThreadLocal WebDriver so this is safe.
  -->

</suite>
